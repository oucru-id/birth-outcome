digraph pipeline {
graph [rankdir=TB, bgcolor="white", fontname="DejaVu Sans", fontsize=14,
       nodesep=0.26, ranksep=0.40, pad=0.14, compound=true, newrank=true];
node [shape=box, fontname="DejaVu Sans", fontsize=11, color="#60768A",
      penwidth=0.8, margin="0.14,0.09"];
edge [fontname="DejaVu Sans", fontsize=9, color="#60768A", arrowsize=0.7];
subgraph cluster_simrs { label="SIMRS | hospital births"; color="#7B69AE"; penwidth=1.5; style="rounded"; bgcolor="#FAFCFE";
mr [label="raw_data.simrs_patut_patuh_inc", fillcolor="#F1F3F5", style="rounded,filled"];
mv [label="vs_simrs_patut_patuh_inc", fillcolor="#E8EFF8", style="rounded,filled"];
mr -> mv;
}
subgraph cluster_kobo { label="Kobo | INC cases and neonatal\noutcomes"; color="#C08C31"; penwidth=1.5; style="rounded"; bgcolor="#FAFCFE";
kr [label="data_kobo_form\ne-form_pencatatan_pelayanan_\nintranatal_care", fillcolor="#F1F3F5", style="rounded,filled"];
ka [label="data_adjudication.adj_final", fillcolor="#F1F3F5", style="rounded,filled"];
kv [label="vs_kobo_inc_submission_clean", fillcolor="#E8EFF8", style="rounded,filled"];
kc [label="vs_kobo_inc_case_master", fillcolor="#E8EFF8", style="rounded,filled"];
kn [label="data_kobo_form.neonatus_outcome_v2", fillcolor="#F1F3F5", style="rounded,filled"];
kb [label="vs_kobo_neonatus_outcome_v2_baby", fillcolor="#E8EFF8", style="rounded,filled"];
kr -> kv;
kv -> kc;
ka -> kc;
kn -> kb;
}
subgraph cluster_facility { label="Facility birth reports | external"; color="#B4697E"; penwidth=1.5; style="rounded"; bgcolor="#FAFCFE";
fr [label="Facility birth reporting\nRaw ingestion / tracker build not\ndefined in this repository", fillcolor="#F8EDF0", style="rounded,filled,dashed"];
fv [label="birth_report_faskes.v_inc_report_\ntracker", fillcolor="#E8EFF8", style="rounded,filled"];
fr -> fv [label="external boundary", style="dashed"];
}
oe [label="t_pregnancy_outcome_events_v3_3", fillcolor="#E8F2EE", style="rounded,filled"];
mv -> oe;
kc -> oe;
kb -> oe;
fv -> oe;
}
